[node name="SyntaxGuidePlaque" parent="InfoPlaques" instance=ExtResource("4_info_plaque")]
layout_mode = 3
anchors_preset = 0
offset_left = 187.0
offset_top = -160.0
offset_right = 407.0
offset_bottom = -40.0
title = "Syntax Guide"
content = "Start here! An interactive tutorial
that teaches Bobbin syntax through
dialogue itself.

Covers all 5 core keywords:
[code]save[/code], [code]set[/code], [code]extern[/code],
choices with [code]-[/code], and [code]{variables}[/code]."
metadata/_edit_use_anchors_ = true

[node name="StorytellerPlaque" parent="InfoPlaques" instance=ExtResource("4_info_plaque")]
layout_mode = 3
anchors_preset = 0
offset_left = -1366.0
offset_top = -750.0
offset_right = -1136.0
offset_bottom = -630.0
title = "Multi-line Dialogue"
content = "The simplest Bobbin feature:
plain text lines.

Each line = one dialogue box.
No special syntax needed."

[node name="MerchantPlaque" parent="InfoPlaques" instance=ExtResource("4_info_plaque")]
layout_mode = 3
anchors_preset = 0
offset_left = -383.0
offset_top = -1050.0
offset_right = -153.0
offset_bottom = -930.0
title = "Choice Branching"
content = "Use [code]-[/code] to create choices.
Indent responses below each choice.

Choices can be nested!
Great for dialogue trees."

[node name="MemoryKeeperPlaque" parent="InfoPlaques" instance=ExtResource("4_info_plaque")]
layout_mode = 3
anchors_preset = 0
offset_left = 624.0
offset_top = -1047.0
offset_right = 854.0
offset_bottom = -927.0
title = "Persistent Variables"
content = "[code]save[/code] declares variables that
persist between conversations.

[code]set[/code] changes their value.

Talk twice to see it remember!"

[node name="OraclePlaque" parent="InfoPlaques" instance=ExtResource("4_info_plaque")]
