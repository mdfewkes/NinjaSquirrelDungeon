; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Legend of Shadowtail"
run/main_scene="uid://dk20rvipu2exi"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/2d_panning_strength=1.0
driver/mix_rate=48000

[autoload]

AudioManager="*res://scenes/AudioManager/audio_manager.tscn"
InventoryManager="*res://code/InventoryManager.gd"
FeatureFlags="*res://code/FeatureFlags.gd"
DialogueBox="*res://scenes/DialogueBox/dialogue_box.tscn"
ImpactEffects="*res://code/ImpactEffects.gd"
StateManager="*res://code/StateManager.gd"

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_tools/plugin.cfg")

[global_group]

player=""
navigation_polygon_source_geometry_group=""
present_lights=""
world_environment=""
inventory_icons=""
persisted=""

